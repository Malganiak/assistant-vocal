# Reglages de l'assistant vocal.
#
# Copier ce fichier en `.env` puis decommenter ce que vous voulez changer :
#
#     cp .env.example .env
#
# Tout est facultatif. Sans `.env`, les valeurs ci-dessous sont celles qui
# s'appliquent -- le projet fonctionne tel quel.
#
# Deux choses a savoir :
#
#   1. `.env` n'est jamais commite (il est dans .gitignore) parce qu'il peut
#      contenir une cle d'API. Le modele a partager, c'est ce fichier-ci.
#
#   2. docker compose lit aussi `.env`, mais SEULEMENT pour remplacer les
#      ${VARIABLES} de compose.yaml. Il n'injecte rien dans les conteneurs :
#      ce qui doit arriver dans un conteneur passe par le bloc `environment:`
#      de compose.yaml.


# --- Serveur -----------------------------------------------------------------

# Interface d'ecoute du serveur temps reel.
# A LAISSER sur 127.0.0.1 : cette API n'a AUCUNE authentification. Quiconque
# peut l'atteindre peut parler a votre assistant et consommer votre machine.
# 0.0.0.0 n'est legitime que dans un conteneur, derriere le reseau Docker --
# et compose.yaml le fait deja pour vous.
#VOICE_HOST=127.0.0.1
#VOICE_PORT=8765

# debug | info | warning | error
# `debug` affiche notamment les emotions choisies par le LLM a chaque replique.
#VOICE_LOG_LEVEL=info


# --- Modele de langue --------------------------------------------------------

# local : le LLM tourne sur votre machine, rien ne sort. C'est le defaut.
# api   : le LLM est appele par HTTP. Moins de memoire et de calcul en local,
#         souvent de meilleures reponses, mais le texte transcrit part chez le
#         fournisseur et il faut une cle.
#VOICE_LLM_MODE=local

# Utilise seulement quand VOICE_LLM_MODE=local. Deja present dans votre cache
# HuggingFace : le changer declenchera un telechargement.
#VOICE_LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit

# Utilises seulement quand VOICE_LLM_MODE=api.
# VOICE_API_BASE_URL vide = OpenAI. Pour un serveur compatible local, par
# exemple llama.cpp : http://127.0.0.1:8080/v1
#VOICE_API_MODEL=gpt-5.6-terra
#VOICE_API_BASE_URL=
#VOICE_API_KEY=

# Note : il n'y a volontairement pas de reglage de temperature pour le LLM.
# Sur le backend mlx-lm, la bibliotheque n'honore que le nombre de tokens
# maximum ; une temperature serait un bouton qui ne fait rien.


# --- Langue et voix ----------------------------------------------------------

# Langue de la transcription. Parakeet couvre 25 langues europeennes.
#VOICE_STT_LANGUAGE=fr

# Langue de la synthese.
#VOICE_TTS_LANGUAGE=fr

# Modele de synthese, et donc MODE DE VOIX : c'est le nom du checkpoint qui
# decide, comme dans la bibliotheque. Un seul reglage, pas deux a accorder.
#
#   ...-Base-...          clonage de la voix de reference   <- le defaut
#   ...-CustomVoice-...   un des neuf locuteurs predefinis
#   ...-VoiceDesign-...   une voix decrite en langage naturel
#
# Le defaut est le clonage, parce que c'est le seul moyen d'obtenir une voix
# reellement francaise : aucun des neuf locuteurs de CustomVoice n'est natif du
# francais, et la documentation amont recommande d'utiliser chaque locuteur dans
# SA langue.
#
# Toujours passer le suffixe de quantification. Sans lui, la bibliotheque
# complete en `-6bit`, une variante qui n'existe pas pour le checkpoint Base.
#
# 8bit plutot que bf16, mesure a l'appui : les deux produisent le meme nombre de
# pas a une unite pres, mais bf16 tourne a RTF 0,59-0,66 -- plus lent que le
# temps reel, donc inutilisable en conversation -- quand 8bit tient 1,33-2,59.
#VOICE_TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-Base-8bit


# Voix de reference du clonage. Vides = la voix francaise livree avec le paquet
# (src/assistant_vocal/voix_francaise.wav et son .txt).
#
# Les DEUX vont par paire, et le demarrage echoue si vous n'en donnez qu'un. Le
# clonage aligne le texte de reference sur l'audio de reference pour en deduire
# le timbre : une transcription approximative degrade la voix produite. Elle
# doit correspondre MOT POUR MOT a ce qui est prononce.
#
# L'audio est normalise automatiquement (mono, 24 kHz) : n'importe quel format
# lisible par soundfile convient. Comptez une dizaine de secondes de parole
# propre, sans musique ni bruit de fond.
#VOICE_TTS_REF_AUDIO=
#VOICE_TTS_REF_TEXT=


# Locuteur predefini. SANS EFFET en clonage -- le checkpoint Base n'a aucun
# locuteur. Ne sert que si VOICE_TTS_MODEL pointe sur un CustomVoice.
# Ce sont exactement ceux du menu deroulant de l'UI de demo, classes par
# hauteur de voix mesuree :
#   aiden 124 Hz (grave, le plus present)   uncle_fu 219 Hz
#   ryan 146 Hz                             vivian 227 Hz
#   dylan 151 Hz (grave, tres discret)      ono_anna 240 Hz
#   sohee 184 Hz                            serena 249 Hz (le plus aigu)
#   eric 195 Hz (forte variation d'intonation)
# Attention : quand vous passez par l'UI web, c'est SON menu deroulant qui
# decide, et ce reglage-ci n'a plus d'effet.
#VOICE_TTS_SPEAKER=aiden


# --- Synthese : latence ------------------------------------------------------

# Pas de codec par paquet audio. Chaque pas coute environ 30 ms avant le
# premier son. Mesure : 4 pas donnent 260 ms, 8 pas 364 ms, 16 pas 572 ms, pour
# un debit de generation quasi identique. 4 produit aussi le moins de
# discontinuites aux jointures : agrandir ne « lisse » rien.
#VOICE_TTS_CHUNK_SIZE=4

# Plafond de tokens audio par replique. Trop bas, une longue phrase est coupee
# net au milieu.
#VOICE_TTS_MAX_TOKENS=1536


# --- Synthese : echantillonnage ----------------------------------------------
#
# Ces quatre reglages n'ont aucune option en ligne de commande dans la
# bibliotheque : le projet les injecte lui-meme (voir src/assistant_vocal/
# patches.py, rustine 2).

# Plus bas = plus stable et plus plat. Plus haut = plus expressif et plus
# instable. 0.9 est le defaut du modele.
#VOICE_TTS_TEMPERATURE=0.9

# top_p 0.9 coupe la queue de la distribution : moins de mots ecorches, sans
# perdre la variete. 1.0 ne coupe rien.
#VOICE_TTS_TOP_K=50
#VOICE_TTS_TOP_P=1.0

# Monter vers 1.1 casse les begaiements sur les textes longs, au prix de la
# prosodie.
#VOICE_TTS_REPETITION_PENALTY=1.05


# --- Comportement ------------------------------------------------------------

# Nombre de phrases que le LLM accumule avant que la synthese demarre. A 1,
# l'assistant commence a parler des la premiere phrase finie.
#VOICE_BATCH_SENTENCES=1

# Coupe le micro pendant que l'assistant parle.
# true  : indispensable sur haut-parleur, sinon l'assistant s'entend et se
#         coupe tout seul (il n'y a pas d'annulation d'echo).
# false : au casque, vous pouvez lui couper la parole. L'echange est bien plus
#         vivant.
#VOICE_BLOCK_MIC_DURING_PLAYBACK=true


# --- Emotions ----------------------------------------------------------------

# Le LLM prefixe chaque replique d'une etiquette ([joie], [empathie]...) que le
# projet traduit en consigne de ton pour la synthese.
# false : les etiquettes sont quand meme retirees du texte, mais le ton ne
#         change plus.
#
# false PAR DEFAUT, parce que le clonage de voix et les emotions sont
# MUTUELLEMENT EXCLUSIFS. Ce n'est pas un choix de gout : le ton se demande par
# le parametre `instruct`, et le chemin de clonage ne le transmet jamais.
# mlx-audio le dit lui-meme ailleurs dans son code : « Qwen3-TTS batch reference
# cloning does not support instructs ».
#
# La voix clonee porte donc la prosodie de sa reference, et rien d'autre. Le
# retrait des etiquettes continue de fonctionner, et c'est indispensable : une
# etiquette laissee dans le texte se ferait PRONONCER.
#
# Repassez a true si vous revenez sur un checkpoint CustomVoice. `doctor` vous
# previent si vous l'activez alors que le clonage est en place.
#VOICE_EMOTIONS=false

# L'UI de demo envoie TOUJOURS son propre prompt systeme, ce qui ecraserait
# celui du projet et ferait cesser les emotions. Par defaut, le projet protege
# son prompt et ignore celui de l'UI.
# true : laisse l'UI gagner. A n'activer que pour experimenter depuis son champ
#        « Instructions » -- pensez alors a y coller le prompt du projet :
#            uv run assistant-vocal prompt --copy
#VOICE_ALLOW_UI_PROMPT=false
